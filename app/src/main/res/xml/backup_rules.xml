<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 8-11 (API 26-30). allowBackup="false" already disables backup;
    this excludes everything as well, so no personal data is backed up on any version.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
