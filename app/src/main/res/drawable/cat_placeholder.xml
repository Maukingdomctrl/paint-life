<?xml version="1.0" encoding="utf-8"?>
<!--
    TEMPORARY placeholder for every Cat League avatar until the owner's cat photos are imported.
    Each cat_<key> resource is an alias of this file (res/values/cat_art_<key>.xml). Importing a
    photo replaces that alias with res/drawable-nodpi/cat_<key>.webp. Delete this file only when
    all ten photos are in. The UI detects that a slot still uses this vector and shows the cat's
    initial on top so the ten cats can be told apart.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="160dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:fillColor="#FF1C2128"
        android:pathData="M0,0h100v100h-100z" />
    <path
        android:fillColor="#FF30363D"
        android:pathData="M22,44 L27,16 L43,31 Q50,29 57,31 L73,16 L78,44 Q84,56 79,67 Q71,86 50,88 Q29,86 21,67 Q16,56 22,44 Z" />
</vector>
